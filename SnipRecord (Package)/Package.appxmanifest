<?xml version="1.0" encoding="utf-8"?>

<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap3 rescap">

  <!-- Sideload identity (self-signed in CI). CI stamps the third field with the
       run number (1.0.N.0). Publisher must equal PUBLISHER in build.yml. -->
  <Identity
    Name="hq970123.SnipRecord"
    Publisher="CN=hq970123"
    Version="1.0.0.0" />

  <Properties>
    <DisplayName>截图录屏 - WidBar 小组件</DisplayName>
    <PublisherDisplayName>hq970123</PublisherDisplayName>
    <Logo>Images\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Universal" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
  </Dependencies>

  <Resources>
    <Resource Language="x-generate"/>
  </Resources>

  <Applications>
    <Application Id="App"
      Executable="$targetnametoken$.exe"
      EntryPoint="$targetentrypoint$">
      <uap:VisualElements
        DisplayName="截图录屏 - WidBar 小组件"
        Description="一键截图、矩形/窗口录屏、屏幕取色"
        BackgroundColor="transparent" Square150x150Logo="Images\MediumTile.png" Square44x44Logo="Images\AppIcon.png">
        <uap:DefaultTile Square71x71Logo="Images\SmallTile.png" Wide310x150Logo="Images\WideTile.png" Square310x310Logo="Images\LargeTile.png"/>
        <uap:SplashScreen Image="Images\SplashScreen.png"/>
      </uap:VisualElements>
      <Extensions>
        <!-- This is what makes WidBar discover the widget. -->
        <uap3:Extension Category="windows.appExtension">
          <uap3:AppExtension
            Name="com.widbar.widget"
            Id="widget"
            PublicFolder="Public"
            DisplayName="截图录屏"
            Description="一键截图、矩形/窗口录屏、屏幕取色">
            <uap3:Properties>
              <WidBarPluginId>com.hq970123.sniprecord</WidBarPluginId>
              <WidBarSdkVersion>2</WidBarSdkVersion>
            </uap3:Properties>
          </uap3:AppExtension>
        </uap3:Extension>
        <!-- sniprecord:// is the redirect target for Snipping Tool's
             ms-screenclip response (and our own deep links). Program.cs routes
             protocol activations to the running widget process. -->
        <uap:Extension Category="windows.protocol">
          <uap:Protocol Name="sniprecord">
            <uap:DisplayName>截图录屏</uap:DisplayName>
          </uap:Protocol>
        </uap:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <!-- Windows.Graphics.Capture: no yellow border, and capture without the
         system picker (GraphicsCaptureItem.TryCreateFromWindowId/DisplayId). -->
    <rescap:Capability Name="graphicsCaptureWithoutBorder" />
    <rescap:Capability Name="graphicsCaptureProgrammatic" />
    <!-- Optional microphone track when recording. -->
    <DeviceCapability Name="microphone" />
  </Capabilities>
</Package>
